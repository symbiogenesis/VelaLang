{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vela pure development inspection version 6",
  "$defs": {
    "concrete": {
      "type": "object", "additionalProperties": false, "required": ["kind", "text", "span"],
      "properties": {
        "kind": {"enum": ["keyword", "identifier", "decimal", "punctuation", "whitespace", "line-comment", "documentation-comment"]},
        "text": {"type": "string", "minLength": 1}, "span": {"$ref": "#/$defs/span"}
      }
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "span": {
      "type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}],
      "items": false, "minItems": 2
    },
    "handle": {"type": "string", "pattern": "^[0-9a-f]{64}:symbol:[0-9]+$"},
    "scope_handle": {"type": "string", "pattern": "^[0-9a-f]{64}:scope:[0-9]+$"},
    "lexical_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "node", "span", "parent", "children", "symbols"],
      "properties": {
        "id": {"$ref": "#/$defs/scope_handle"}, "kind": {"enum": ["module", "function", "block"]},
        "node": {"$ref": "#/$defs/node_handle"}, "span": {"$ref": "#/$defs/span"},
        "parent": {"oneOf": [{"$ref": "#/$defs/scope_handle"}, {"type": "null"}]},
        "children": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/scope_handle"}},
        "symbols": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/handle"}}
      }
    },
    "node_handle": {"type": "string", "pattern": "^[0-9a-f]{64}:node:[0-9]+$"},
    "syntax": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "span", "parent", "role", "index", "children", "value", "const"],
      "properties": {
        "id": {"$ref": "#/$defs/node_handle"},
        "kind": {"enum": ["module", "function", "constant", "parameter", "type", "block", "binding", "local-constant", "return", "if", "expression-body", "nat", "bool", "name", "call", "argument", "binary", "unary", "group", "identifier", "operator"]},
        "span": {"$ref": "#/$defs/span"},
        "parent": {"oneOf": [{"$ref": "#/$defs/node_handle"}, {"type": "null"}]},
        "role": {"enum": ["root", "name", "declarations", "result", "parameters", "body", "type", "bindings", "exit", "value", "condition", "then", "else", "callee", "arguments", "label", "left", "operator", "right"]},
        "index": {"type": ["integer", "null"], "minimum": 0},
        "children": {"type": "array", "maxItems": 8192, "items": {"$ref": "#/$defs/node_handle"}},
        "value": {"type": ["string", "boolean", "null"]},
        "const": {"type": ["boolean", "null"]}
      }
    },
    "type": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "name"],
          "properties": {"kind": {"const": "scalar"}, "name": {"enum": ["Nat", "bool"]}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "result", "parameters", "const"],
          "properties": {
            "kind": {"const": "function"}, "result": {"enum": ["Nat", "bool"]},
            "const": {"type": "boolean"},
            "parameters": {
              "type": "array", "maxItems": 1024,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["type", "required_static"],
                "properties": {"type": {"enum": ["Nat", "bool"]}, "required_static": {"type": "boolean"}}
              }
            }
          }
        }
      ]
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "source_sha256", "producer", "configuration", "target", "coordinate_unit", "symbol_lifetime"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/digest"},
        "configuration": {"type": "string"}, "target": {"type": "string"},
        "coordinate_unit": {"const": "utf8-byte"}, "symbol_lifetime": {"const": "snapshot"},
        "producer": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "stage", "version", "dependencies", "python", "implementation"],
          "properties": {
            "name": {"const": "vela-pure-development"}, "stage": {"const": "pure-resolution"},
            "version": {"$ref": "#/$defs/digest"},
            "dependencies": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/digest"}},
            "python": {"type": "string", "minLength": 1}, "implementation": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "symbol": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "kind", "detail", "type", "span", "origin", "documentation", "scope", "available_from"],
      "properties": {
        "id": {"$ref": "#/$defs/handle"}, "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"},
        "kind": {"enum": ["function", "parameter", "variable", "constant"]},
        "detail": {"type": "string", "minLength": 1}, "span": {"$ref": "#/$defs/span"},
        "type": {"$ref": "#/$defs/type"},
        "documentation": {"type": ["string", "null"]},
        "scope": {"$ref": "#/$defs/scope_handle"}, "available_from": {"type": "integer", "minimum": 0},
        "origin": {
          "type": "object", "additionalProperties": false, "required": ["kind", "span"],
          "properties": {"kind": {"const": "authored"}, "span": {"$ref": "#/$defs/span"}}
        }
      },
      "allOf": [{
        "if": {"properties": {"kind": {"const": "function"}}},
        "then": {"properties": {"type": {"properties": {"kind": {"const": "function"}}}}},
        "else": {"properties": {"type": {"properties": {"kind": {"const": "scalar"}}}}}
      }]
    },
    "occurrence": {
      "type": "object", "additionalProperties": false, "required": ["symbol", "span", "declaration", "scope"],
      "properties": {
        "symbol": {"$ref": "#/$defs/handle"}, "span": {"$ref": "#/$defs/span"}, "declaration": {"type": "boolean"},
        "scope": {"$ref": "#/$defs/scope_handle"}
      }
    },
    "expression": {
      "type": "object", "additionalProperties": false, "required": ["node", "span", "type"],
      "properties": {
        "node": {"$ref": "#/$defs/node_handle"}, "span": {"$ref": "#/$defs/span"},
        "type": {
          "type": "object", "additionalProperties": false, "required": ["kind", "name"],
          "properties": {"kind": {"const": "scalar"}, "name": {"enum": ["Nat", "bool"]}}
        }
      }
    },
    "type_at": {
      "type": "object", "additionalProperties": false, "required": ["symbol", "span", "type"],
      "properties": {
        "symbol": {"$ref": "#/$defs/handle"}, "span": {"$ref": "#/$defs/span"}, "type": {"$ref": "#/$defs/type"}
      }
    }
  },
  "type": "object",
  "required": ["schema", "scope", "snapshot", "binding", "status", "complete", "reason"],
  "properties": {
    "schema": {"const": 6}, "snapshot": {"$ref": "#/$defs/digest"}, "binding": {"$ref": "#/$defs/binding"},
    "status": {"enum": ["checked", "unavailable", "timed-out", "partial", "unsupported", "refused"]},
    "complete": {"type": "boolean"}, "reason": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "checked"}}},
      "then": {"properties": {"complete": {"const": true}, "reason": {"type": "null"}}},
      "else": {"properties": {"complete": {"const": false}, "reason": {"type": "string", "minLength": 1}}}
    },
    {
      "oneOf": [
        {
          "required": ["source", "symbols", "occurrences", "concrete", "syntax", "expressions", "scopes", "supported_views", "unsupported_views"],
          "properties": {
            "scope": {"const": "vela-pure-inspection"}, "source": {"type": "string"},
            "symbols": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/symbol"}},
            "occurrences": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/occurrence"}},
            "concrete": {"type": "array", "maxItems": 16384, "items": {"$ref": "#/$defs/concrete"}},
            "syntax": {"type": "array", "maxItems": 8192, "items": {"$ref": "#/$defs/syntax"}},
            "expressions": {"type": "array", "maxItems": 8192, "items": {"$ref": "#/$defs/expression"}},
            "scopes": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/lexical_scope"}},
            "supported_views": {"const": ["source-text", "pure-concrete-pieces", "pure-resolved-identifiers", "pure-syntax-tree", "pure-typed-expressions", "pure-lexical-scopes"]},
            "unsupported_views": {"const": ["imports", "generated-origins", "proof", "lowering"]}
          },
          "allOf": [{
            "if": {"properties": {"status": {"not": {"const": "checked"}}}},
            "then": {"properties": {"symbols": {"maxItems": 0}, "occurrences": {"maxItems": 0}, "concrete": {"maxItems": 0}, "syntax": {"maxItems": 0}, "expressions": {"maxItems": 0}, "scopes": {"maxItems": 0}}}
          }]
        },
        {
          "required": ["items", "total"],
          "properties": {
            "scope": {"const": "vela-pure-inspection-query"}, "total": {"type": "integer", "minimum": 0},
            "items": {"type": "array", "maxItems": 256, "items": {"oneOf": [{"$ref": "#/$defs/symbol"}, {"$ref": "#/$defs/occurrence"}, {"$ref": "#/$defs/type_at"}, {"$ref": "#/$defs/concrete"}, {"$ref": "#/$defs/syntax"}, {"$ref": "#/$defs/expression"}, {"$ref": "#/$defs/lexical_scope"}]}}
          }
        }
      ]
    }
  ],
  "unevaluatedProperties": false
}
