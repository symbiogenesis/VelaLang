# Repository-provisioned worktrees use this provider-neutral root on every OS.
/.worktrees/

# Trusted action checkout used by hosted target campaigns on pinned revisions.
/.target-ci/

# Existing and host-provisioned worktrees retain their assigned locations.
/.Codex/worktrees/
/.codex/worktrees/
/.claude/worktrees/

# Derived tool environments, caches, and build outputs.
/out/
/build/
__pycache__/
.ruff_cache/
.rumdl_cache/
