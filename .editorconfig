# SPDX-License-Identifier: Apache-2.0
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{py,vela}]
indent_size = 4

[*.{md,json,toml,yml,yaml,mjs,js,css,html,ml,mli,mll,mly,v}]
indent_size = 2

[*.md]
max_line_length = off

# These trees keep their own bytes or editor policy. Do not propagate this
# checkout's defaults into worktrees or derived build/venv directories.
[{.worktrees,.Codex/worktrees,.codex/worktrees,.claude/worktrees,out,build}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
tab_width = unset
